<?xml version="1.0" encoding="UTF-8"?>
<!--
  S1_WZ1 SUMO routes file
  =======================
  • Defines vehicle types and named loop routes for Town02.
  • Does NOT pre-spawn any vehicles.  All vehicles are injected via
    TraCI (BackgroundTrafficSynchronizer.spawn_initial_traffic /
    tick_poisson_spawn).

  Edge IDs are taken from the Town02.net.xml loop used in history_sumo/July27_S1.
  Routes repeat the loop twice so a vehicle has enough route length to last
  through a full episode (max ~120 s × 8 m/s ≈ 960 m ≫ one loop ~700 m).
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ================================================================ -->
    <!-- Vehicle types                                                     -->
    <!-- ================================================================ -->

    <vType id="car"
           vClass="passenger"
           length="4.5" width="1.8" height="1.5"
           maxSpeed="13.9" accel="2.6" decel="4.5"
           sigma="0.5" tau="1.2" minGap="2.5"/>

    <vType id="truck"
           vClass="truck"
           length="7.5" width="2.4" height="3.0"
           maxSpeed="11.1" accel="1.5" decel="3.5"
           sigma="0.3" tau="1.5" minGap="3.0"/>

    <vType id="passenger"
           vClass="passenger"
           length="4.5" width="1.8" height="1.5"
           maxSpeed="13.9" accel="2.6" decel="4.5"
           sigma="0.5" tau="1.2" minGap="2.5"/>

    <!-- ================================================================ -->
    <!-- Ego proxy placeholder route                                       -->
    <!-- Position is overridden each step by moveToXY; this route is only -->
    <!-- needed so traci.vehicle.add() has a valid routeID.               -->
    <!-- ================================================================ -->
    <route id="ego_placeholder" edges="17"/>

    <!-- ================================================================ -->
    <!-- Background traffic loop routes (Town02, two loops each)          -->
    <!-- ================================================================ -->

    <!-- Loop starting from edge 17 -->
    <route id="bg_route_01"
           edges="17 -13 -14 -15 3 -12 16 1 0 2 -18 -19
                  17 -13 -14 -15 3 -12 16 1 0 2 -18 -19 17"/>

    <!-- Loop starting from edge -13 -->
    <route id="bg_route_02"
           edges="-13 -14 -15 3 -12 16 1 0 2 -18 -19 17
                  -13 -14 -15 3 -12 16 1 0 2 -18 -19 17 -13"/>

    <!-- Loop starting from edge 3 -->
    <route id="bg_route_03"
           edges="3 -12 16 1 0 2 -18 -19 17 -13 -14 -15
                  3 -12 16 1 0 2 -18 -19 17 -13 -14 -15 3"/>

    <!-- ================================================================ -->
    <!-- WZ1 Path 2: -13 → -14 → 6  (left turn at junction 242 onto       -->
    <!-- the upper east-west road, continues via 5 → 4 → 0 loop)          -->
    <!-- ================================================================ -->

    <!-- Loop starting from edge 17, exit via 6 -->
    <route id="bg_route_04"
           edges="17 -13 -14 6 5 4 0 2 -18 -19
                  17 -13 -14 6 5 4 0 2 -18 -19 17"/>

    <!-- Loop starting from edge -13, exit via 6 -->
    <route id="bg_route_05"
           edges="-13 -14 6 5 4 0 2 -18 -19 17
                  -13 -14 6 5 4 0 2 -18 -19 17 -13"/>

    <!-- Loop starting from edge -14, exit via 6 -->
    <route id="bg_route_06"
           edges="-14 6 5 4 0 2 -18 -19 17 -13
                  -14 6 5 4 0 2 -18 -19 17 -13 -14"/>

</routes>
