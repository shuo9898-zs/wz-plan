        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="car" vClass="passenger" length="4.5" width="1.8" height="1.5"
           maxSpeed="13.9" accel="2.6" decel="4.5" sigma="0.5" tau="2.4" minGap="2.5"/>
