<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test S1 (stable internal S5) WZ1 SUMO routes. Vehicles are injected by
  TraCI; this file defines no pre-spawned vehicles. bg_route_01 is the fixed
  five-car rear stream, bg_route_02 is the fixed three-car front stream, and
  bg_route_03 is the opposing normal-flow base stream.
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="car" vClass="passenger"
           length="4.5" width="1.8" height="1.5"
           maxSpeed="13.9" accel="2.6" decel="4.5"
           sigma="0.5" tau="1.2" minGap="2.5"/>
    <vType id="truck" vClass="truck"
           length="7.5" width="2.4" height="3.0"
           maxSpeed="11.1" accel="1.5" decel="3.5"
           sigma="0.3" tau="1.5" minGap="3.0"/>
    <vType id="passenger" vClass="passenger"
           length="4.5" width="1.8" height="1.5"
           maxSpeed="13.9" accel="2.6" decel="4.5"
           sigma="0.5" tau="1.2" minGap="2.5"/>

    <route id="ego_placeholder" edges="-17 -18 -40"/>
    <route id="bg_route_01" edges="-17 -18 -40"/>
    <route id="bg_route_02" edges="-40 -41"/>
    <route id="bg_route_03" edges="40 18 0"/>
</routes>
