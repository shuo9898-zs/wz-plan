<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test S1 internal / S5 High Traffic display-role routes
  =======================================================
  • Defines two merging rear routes in one shared base high-traffic
    pool and one fixed five-vehicle route ahead of Ego.
  • Does NOT pre-spawn any vehicles.  All vehicles are injected via
    TraCI (BackgroundTrafficSynchronizer.spawn_initial_traffic /
    tick_poisson_spawn).
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ================================================================ -->
    <!-- Vehicle types                                                     -->
    <!-- ================================================================ -->

    <vType id="car"
           vClass="passenger"
           length="4.5" width="1.8" height="1.5"
           maxSpeed="13.9" accel="2.6" decel="4.5"
           sigma="0.5" tau="1.2" minGap="8.0"/>

    <vType id="truck"
           vClass="truck"
           length="7.5" width="2.4" height="3.0"
           maxSpeed="11.1" accel="1.5" decel="3.5"
           sigma="0.3" tau="1.5" minGap="3.0"/>

    <vType id="passenger"
           vClass="passenger"
           length="4.5" width="1.8" height="1.5"
           maxSpeed="13.9" accel="2.6" decel="4.5"
           sigma="0.5" tau="1.2" minGap="2.5"/>

    <!-- ================================================================ -->
    <!-- Ego proxy placeholder route                                       -->
    <!-- Position is overridden each step by moveToXY; this route is only -->
    <!-- needed so traci.vehicle.add() has a valid routeID.               -->
    <!-- ================================================================ -->
    <route id="ego_placeholder" edges="5 4"/>

    <!-- Rear base stream entering through edge 6. -->
    <route id="bg_route_01" edges="6 5 4"/>

    <!-- Rear base stream merging from edges -10 and -9. -->
    <route id="bg_route_02" edges="-10 -9 5 4"/>

    <!-- Fixed five-vehicle stream, inserted 10 m into edge 5. -->
    <route id="bg_route_03" edges="5 4"/>

</routes>
